@page
@using LibrarySystem.Web.Pages.Shared
@using LibrarySystem.Web.ViewModels
@model LibrarySystem.Web.Pages.Admin.BookManagement.IndexModel
@{
    ViewData["Title"] = "Book Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-6">@ViewData["Title"]</h1>
        <p class="text-muted">Add, edit, and manage all book titles and their copies.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill me-2"></i>Add New Title</a>
</div>

<!-- Display Status Messages -->
@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Genre</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.ISBN</td>
                        <td>@book.Genre</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary" title="Edit Metadata"><i class="bi bi-pencil-square"></i></a>
                                <a asp-page="ManageCopies" asp-route-bookId="@book.Id" class="btn btn-sm btn-outline-secondary" title="Manage Copies"><i class="bi bi-journal-check"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            CurrentPage = Model.CurrentPage,
            TotalPages = Model.TotalPages,
        })
    </div>
</div>
