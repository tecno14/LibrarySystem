@page "{isbn}"
@using LibrarySystem.Common.Enums
@using LibrarySystem.Web.ViewModels
@model LibrarySystem.Web.Pages.DetailsModel
@{
    ViewData["Title"] = Model.Book?.Title ?? "Book Details";
}

@if (Model.Book != null)
{
    <div class="container mt-4">
        <!-- Display Success/Error Messages from TempData -->
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-dismissible @(TempData["IsSuccess"] as bool? == true ? "alert-success" : "alert-danger")" role="alert">
                @TempData["StatusMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <!-- Book Cover and Main Info -->
            <div class="col-md-4">
                @await Html.PartialAsync("_BookCoverPlaceholder", new BookCoverViewModel
                {
                    Title = Model.Book.Title,
                    CoverImageUrl = Model.Book.CoverImageUrl,
                    IsListView = false,
                })
        </div>

        <div class="col-md-8">
            <h1 class="display-5">@Model.Book.Title</h1>
            <h4 class="text-muted">by @Model.Book.Author</h4>
            <hr />
            <p><strong>ISBN:</strong> @Model.Book.ISBN</p>
            <p><strong>Publisher:</strong> @(Model.Book.Publisher ?? "N/A")</p>
            <p><strong>Genre:</strong> @(Model.Book.Genre ?? "N/A")</p>

            <!-- Borrow Button (conditionally displayed) -->
            @if (User.Identity?.IsAuthenticated == true && Model.Book.AvailableCopies > 0)
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isbn" value="@Model.Book.ISBN" />
                        <button type="submit" class="btn btn-success btn-lg" asp-page-handler="Borrow">
                            Borrow a Copy
                        </button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated == false)
                {
                    <a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path" class="btn btn-primary btn-lg">
                        Login to Borrow
                    </a>
                }
                else
                {
                    <p class="alert alert-warning">All copies are currently checked out.</p>
                }
            </div>
        </div>

        <!-- List of Physical Copies -->
        <div class="mt-5">
            <h3>Copies in this Library (@Model.Copies.Count())</h3>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Copy ID</th>
                        <th>Status</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var copy in Model.Copies)
                    {
                        <tr>
                            <td>@copy.Id</td>
                            <td>
                                <span class="badge @(copy.Status == BookCopyStatus.Available ? "bg-success" : "bg-secondary")">
                                    @copy.Status
                                </span>
                            </td>
                            <td>@(copy.Location ?? "Main Shelf")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <p>The book you are looking for could not be found.</p>
    </div>
    <a asp-page="/Index" class="btn btn-primary">Back to Catalog</a>
}
