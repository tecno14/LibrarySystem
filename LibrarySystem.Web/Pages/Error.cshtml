@page
@model LibrarySystem.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger">Error.</h1>
    <h2 class="display-6">An error occurred while processing your request.</h2>
    <p class="lead text-muted mt-4">
        We apologize for the inconvenience. Please try again later, or contact support if the problem persists.
    </p>

    @*
        This block will only be rendered if the application is running in the Development environment.
        It provides the developer with a unique ID to trace this specific error in the application logs.
    *@
    @if (Model.ShowRequestId)
    {
        <div class="alert alert-info mt-4">
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
            <small>This information is only displayed in the Development environment.</small>
        </div>
    }

    <a asp-page="/Index" class="btn btn-primary mt-3">Return to Home</a>
</div>