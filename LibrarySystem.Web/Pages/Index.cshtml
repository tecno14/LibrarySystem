@page
@using LibrarySystem.Web.Pages.Shared
@using LibrarySystem.Web.ViewModels
@model LibrarySystem.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Public Catalog"; 
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Library</h1>
    <p>Search our collection of books below.</p>
</div>

<hr />

<!-- SEARCH FORM -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-center">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label for="query" class="visually-hidden">Search</label>
                <input asp-for="Query" class="form-control" placeholder="Search by title, author, or ISBN..." />
            </div>
            <div class="col-md-4">
                <label for="genre" class="visually-hidden">Genre</label>
                <select asp-for="Genre" asp-items="Model.GenreOptions" class="form-select">
                    <option value="">All Genres</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>
</div>

<!-- SEARCH RESULTS -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model.SearchResults != null && Model.SearchResults.Any())
    {
        @foreach (var book in Model.SearchResults)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    @await Html.PartialAsync("_BookCoverPlaceholder", new BookCoverViewModel
                    {
                        Title = book.Title,
                        CoverImageUrl = book.CoverImageUrl,
                    })

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="card-text text-muted">by @book.Author</p>
                        <div class="mt-auto">
                            @if (book.AvailableCopies > 0)
                            {
                                <p class="text-success fw-bold">@book.AvailableCopies Available</p>
                            }
                            else
                            {
                                <p class="text-danger fw-bold">All copies checked out</p>
                            }
                            <a asp-page="/Details" asp-route-isbn="@book.ISBN" class="btn btn-outline-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-center text-muted">No books found matching your criteria. Try a different search.</p>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", new PaginationViewModel
{
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    RouteValues = new Dictionary<string, string?>
    {
        ["Query"] = Model.Query,
        ["Genre"] = Model.Genre
    }
})