@page
@model LibrarySystem.Web.Pages.Member.MyBooksModel
@{
    ViewData["Title"] = "My Books";
}

<h1 class="display-5">@ViewData["Title"]</h1>
<p class="text-muted">Manage your currently borrowed books and view your borrowing history.</p>
<hr />

<!-- Display Success/Error Messages from TempData -->
@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-dismissible @(TempData["IsSuccess"] as bool? == true ? "alert-success" : "alert-danger")" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SECTION 1: CURRENTLY BORROWED BOOKS -->
<div class="card shadow-sm mb-5">
    <div class="card-header">
        <h4>Currently Borrowed</h4>
    </div>
    <div class="card-body">
        @if (Model.CurrentBorrowings.Any())
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Borrowed On</th>
                        <th>Due Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var borrowing in Model.CurrentBorrowings)
                    {
                        <tr>
                            <td>@borrowing.BookTitle</td>
                            <td>@borrowing.BookAuthor</td>
                            <td>@borrowing.BorrowDate.ToString("yyyy-MM-dd")</td>
                            <td class="@(borrowing.DueDate < DateTime.UtcNow ? "text-danger fw-bold" : "")">
                                @borrowing.DueDate.ToString("yyyy-MM-dd")
                                @if (borrowing.DueDate < DateTime.UtcNow)
                                {
                                    <span class="ms-2">(Overdue)</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Return">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="borrowingId" value="@borrowing.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Return Book</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-center text-muted">You have no books currently checked out.</p>
        }
    </div>
</div>

<!-- SECTION 2: BORROWING HISTORY -->
<div class="card shadow-sm">
    <div class="card-header">
        <h4>Borrowing History</h4>
    </div>
    <div class="card-body">
        @if (Model.BorrowingHistory.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Borrowed On</th>
                        <th>Returned On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var borrowing in Model.BorrowingHistory)
                    {
                        <tr>
                            <td>@borrowing.BookTitle</td>
                            <td>@borrowing.BookAuthor</td>
                            <td>@borrowing.BorrowDate.ToString("yyyy-MM-dd")</td>
                            <td>@borrowing.ReturnDate?.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-center text-muted">Your borrowing history is empty.</p>
        }
    </div>
</div>
