@using LibrarySystem.Web.ViewModels
@using Microsoft.AspNetCore.Mvc.RazorPages
@model PaginationViewModel

<nav class="col-12 d-flex justify-content-center mt-3 mb-3">
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-pageNumber="1">First</a>
            </li>
            <li class="page-item">
                <a class="page-link"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-pageNumber="@i">@i</a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
            </li>
            <li class="page-item">
                <a class="page-link"
                   asp-all-route-data="Model.RouteValues"
                   asp-route-pageNumber="@Model.TotalPages">Last</a>
            </li>
        }
    </ul>
</nav>
